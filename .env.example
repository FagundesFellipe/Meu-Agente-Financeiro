# === OPENCODE -- NÃO É OBRIGATÓRIO ===
OPENAI_COMPATIBLE_API_KEY=sk-123 
OPENAI_COMPATIBLE_BASE_URL=https://opencode.ai/zen/go/v1

# === ENVIRONMENT ===
# "development" (default) ou "production"
ENVIRONMENT=development
# Trava extra e independente do ENVIRONMENT para a rota /webhook/sync
# (sem auth, sem rate limit — só para testes locais). Precisa ser "true"
# explicitamente para a rota existir, mesmo em dev. Nunca habilite em produção.
ENABLE_SYNC_WEBHOOK=false


# === PROMPT MANAGER SERVE ===
# "development" (default) ou "production"
ENVIRONMENT_PROMPT_MANAGER=development

PROMPT_DIR=src/agents/prompts
MAX_PROMPT_SIZE=100_000
PROMPT_MANAGER_PORT=5000
FLASK_SECRET_KEY=abc123
PROMPT_MANAGER_SERVER_TIMEZONE=America/Sao_Paulo

# === DATABASE ===
POSTGRES_DB=ai_agents
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ai_agents

# === LLM (OpenRouter) ===
# Uma única API key para tudo: chat, embeddings, transcrição de áudio
OPENROUTER_API_KEY=sk-or-v1-xxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=x-ai/grok-4.1-fast
OPENROUTER_MIDIA_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_LIVE_TESTES=1

# === LLM Rate Limit ===
LLM_RATE_LIMIT_REQUESTS_PER_SECOND=0.5
LLM_RATE_LIMIT_MAX_BURST=10

# === LANG SMITH ===
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=<your-api-key>
LANGSMITH_PROJECT="Meu-Assistente-Financeiro"

# === TRIM ===
# Mantém os N turnos mais recentes, descarta os antigos.
# Um turno = 1 HumanMessage + todas as respostas (AI, tools, etc).
# Custo: zero (sem chamada LLM extra)
TRIM_KEEP_TURNS = 3
TRIM_KEEP_TURNS_NODE = 5

# === TWILIO ===
# mock em dev local /real para envio de verdade
TWILIO_OUTBOUND_MODE=mock
# 1) Account SID (Console → Account Info)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 2) API Key SID (Console → Account → API keys & tokens)
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 3) API Key Secret (exibido ao criar a API Key)
TWILIO_API_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 4) Número remetente no formato whatsapp:+14155238886
TWILIO_FROM_NUMBER=whatsapp:+14155238886

# Inbound (validação da assinatura X-Twilio-Signature):
# 5) Auth Token (Console → Account Info)
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 6) URL pública base do túnel — apenas o domínio, sem path
# (NÃO incluir /webhook/twilio?agent=...)
TWILIO_WEBHOOK_URL=https://SEU-TUNNEL.trycloudflare.com
# 7) Em produção: true | Em dev local/simulado: false
VALIDATE_TWILIO_SIGNATURE=false


# === TELEGRAM ===
TELEGRAM_BOT_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_WEBHOOK_SECRET_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# === WORKER ===
POLL_INTERVAL_SECONDS=1.0
LEASE_SECONDS=60
MAX_ATTEMPTS=3