# === OPENCODE -- NÃO É OBRIGATÓRIO ===
OPENAI_COMPATIBLE_API_KEY=sk-123 
OPENAI_COMPATIBLE_BASE_URL=https://opencode.ai/zen/go/v1

# === PROMPT MANAGER SERVE ===
# "development" (default) ou "production"
ENVIRONMENT=development

ENVIRONMENT=develpment
PROMPT_DIR=src/agents/prompts
MAX_PROMPT_SIZE=100_000
PROMPT_MANAGER_PORT=5000
FLASK_SECRET_KEY=abc123
PROMPT_MANAGER_SERVER_TIMEZONE=America/Sao_Paulo

# === DATABASE ===
POSTGRES_DB=ai_agents
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ai_agents

# === LLM (OpenRouter) ===
# Uma única API key para tudo: chat, embeddings, transcrição de áudio
OPENROUTER_API_KEY=sk-or-v1-xxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=x-ai/grok-4.1-fast
OPENROUTER_MIDIA_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_LIVE_TESTES=1

# === LLM Rate Limit ===
LLM_RATE_LIMIT_REQUESTS_PER_SECOND=0.5
LLM_RATE_LIMIT_MAX_BURST=10

# === LANG SMITH ===
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=<your-api-key>
LANGSMITH_PROJECT="Meu-Assistente-Financeiro"